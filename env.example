# All optional. Set these in Vercel → Project → Settings → Environment Variables.

# Site password. When unset, the default password chosen at build time applies (stored only as a hash in lib/auth.js).
SITE_PASSWORD=
# Any random string; changing it signs everyone out.
SESSION_SECRET=
# Set to 1 to switch the password screen off (local development only).
AUTH_DISABLED=

# Point the site at different Google Sheets without touching code.
ACCOUNTS_SHEET_ID=
STAKEHOLDER_SHEET_ID=
# Seconds Vercel's CDN may reuse a Google response (default 10). Lower = fresher, more calls to Google.
CACHE_SECONDS=
